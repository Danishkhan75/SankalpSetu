# Required backend secrets. Generate new, unique values; do not use placeholders in production.
JWT_SECRET=
ADMIN_LOGIN_PASSWORD=
PAYMENT_WEBHOOK_SECRET=

# Optional external service credentials; endpoints requiring them return an error when unset.
GEMINI_API_KEY=
HF_TOKEN=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Database connection (leave unset to use existing snapshot/in-memory fallbacks).
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=

# OAuth and callback configuration.
APP_URL=
GOOGLE_CLIENT_ID=
FACEBOOK_CLIENT_ID=
INSTAGRAM_CLIENT_ID=
CLIENT_ID=

# Public OAuth client identifier used by Vite; this is not a server secret.
VITE_GOOGLE_CLIENT_ID=

# Public Firebase web configuration used by the Vite frontend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK project selection; credentials should come from Application Default Credentials.
FIREBASE_PROJECT_ID=

# Transitional API compatibility. In production, point this only to the retained legacy API.
LEGACY_API_URL=
